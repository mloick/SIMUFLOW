  <mxCell id="b" value="Complet ?" style="rhombus;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="80" height="80" as="geometry"/></mxCell>
  <mxCell id="c" value="Rembourser&lt;br&gt;3 JO" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="120" height="60" as="geometry"/></mxCell>
  <mxCell id="f" value="Fin" style="ellipse;" vertex="1" parent="1"><mxGeometry x="580" y="40" width="60" height="60" as="geometry"/></mxCell>
