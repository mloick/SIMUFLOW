{
  "expo": {
    "name": "SimuFlow",
    "slug": "simuflow",
    "owner": "milock",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6556dd2-a0ce-400c-9efa-56cab7b0df3a"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simuflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.simuflow.app"
    },
    "android": {
      "package": "fr.simuflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f6fa",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0b1621",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "SimuFlow utilise l’appareil photo pour lire un tableau de process. Les photos restent sur votre téléphone.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f6556dd2-a0ce-400c-9efa-56cab7b0df3a"
      }
    }
  }
}
